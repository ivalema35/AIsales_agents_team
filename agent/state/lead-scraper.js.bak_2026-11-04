export const meta = {
  name: 'lead-scraper',
  description: 'Need-driven lead scraper: for any campaign and need it plans its OWN sources (no fixed route), collects evidence-backed candidates with small capped runs, merges and judges them, and re-plans once if the yield is low',
  whenToUse: 'You have a campaign (offer + the need it fixes + geography) and want a first list of candidate leads. Run lead-researcher on the result before anything is added to a campaign.',
  phases: [
    { title: 'Plan', detail: 'one planner reasons from the need to the places where that need is visible, and picks the sources' },
    { title: 'Collect', detail: 'one collector per chosen source, small capped runs, evidence with dates' },
    { title: 'Judge', detail: 'merge, de-duplicate, drop what does not qualify, rank, decide if the yield is enough' },
