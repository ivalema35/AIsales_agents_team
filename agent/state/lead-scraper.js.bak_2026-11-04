async function planRound(feedback, roundNo) {
  const prompt = WHO_WE_ARE + '\n\n' + CAMPAIGN_TEXT + '\n\n' + STANDING_RULES + '\n\n' + APIFY_NOTE + '\n\n' +
    'YOU ARE THE PLANNER of a lead-finding agent. There is NO fixed route: you decide where to look, from the NEED. Do NOT default to any platform because it was used before; choose a source only if you can explain why a business with THIS need leaves a trace there.\n' +
    'Steps: (1) Analyse the need: who has it, and what do such businesses do or show in public because of it? (2) List at least 8 different candidate sources from different categories (ad libraries, maps and directories, statutory registers, job posts, review sites, marketplaces, news and launch lists, event or exhibitor lists, communities, app stores, association member lists, anything else you can justify) and judge each for THIS need: signal strength, reachability (business-published contact), volume in the geography, cost, risk. (3) Choose the best ' + MAX_SOURCES + ' (they may use different tools; if all of them end up as Apify scrapers of the usual India stack, say why no free web or registry source beat them, and prefer a source that shows the need signal itself over one that only lists businesses of the right type) and write a concrete run plan for each: for an Apify source search the Store (search-actors, fetch-actor-details; planning is free, do NOT call-actor now) and name the exact actor and input with small limits; for a web source write the exact queries and filters; for a register write the URL and the fields. Each source budget is at most US$' + PER_SOURCE_CAP + ' (total US$' + CAP + '); free sources are welcome. (4) Say what you would try if the yield is low.\n' +
    'Target: about ' + TARGET + ' usable candidates in total, so choose sources that can plausibly deliver that many for this geography.' +
    (feedback ? '\n\nTHIS IS A RE-PLAN (round ' + roundNo + '). The first plan produced too few usable candidates. What happened: ' + feedback + '\nChoose DIFFERENT sources or clearly different queries; do not repeat what failed.' : '')
  return agent(prompt, { label: 'plan:round' + roundNo, phase: roundNo === 1 ? 'Plan' : 'Replan', schema: PLAN })
}

function collectorPrompt(src, plan) {
  return WHO_WE_ARE + '\n\n' + CAMPAIGN_TEXT + '\n\n' + STANDING_RULES + '\n\n' + APIFY_NOTE + '\n\n' +
    'YOU ARE A COLLECTOR for ONE source chosen by the planner. The planner\'s understanding of the need:\n' + JSON.stringify(plan.need_analysis) + '\n\nYOUR SOURCE:\n' + JSON.stringify(src) + '\n\n' +
    'Execute this plan. Rules: (1) start with a small run; if you call an Apify actor pass small limits and callOptions {maxTotalChargeUsd: ' + PER_SOURCE_CAP + ', maxItems: 40}; never spend more than US$' + PER_SOURCE_CAP + ' on this source; report the estimated cost of every run. (2) If the planned actor or query fails or returns junk, adapt once with another actor or query for the SAME signal, but stay inside the budget. (3) For every candidate keep only what the data shows: the observed signal, its URL and its date. Say what KIND of date it is (signal_date_kind): a date the source itself shows (ad start, post date, approval date) is dated_by_source; "1 week ago" is relative_only; the day YOU scraped is scrape_date_only and must never be written as the signal date. Say how far you checked (evidence_tier): signal_opened only if you opened the evidence URL yourself; if a marketplace/directory row only shows the business fits the profile, it is fit_only, not a signal. If WebSearch/WebFetch is rate-limited or blocked, say so in did_not_work and lower the confidence; never fill the gap with a guess. Set entity_type honestly (end_business, agency_or_vendor, chain, individual, unclear) and DROP chains and agencies yourself. (4) Do a quick sanity check of identity (does the business exist: its own site or listing), but leave deep research to the researcher. (5) Return at most ' + Math.ceil(TARGET * 1.5) + ' candidates, strongest evidence first. Put the source id "' + src.id + '" in source_id. Be honest in did_not_work: it tells the next round what to avoid.'
}

async function collectAll(plan, phaseName) {
  const chosen = plan.chosen.slice(0, MAX_SOURCES)
  return parallel(chosen.map(src => () =>
    agent(collectorPrompt(src, plan), { label: 'collect:' + src.id, phase: phaseName === 'Plan' ? 'Collect' : 'Replan', /* agentType hata diya (30 Oct 2026): daily scheduled task repo ke bahar chalta hai, wahan .claude/agents ke 'scout'/'qualifier' nahi milte aur collectors pehli baar fail ho jaate the; prompt me role already likha hai */ schema: CANDIDATES })
  ))
}

async function judge(allResults, plan, roundNo) {
  const prompt = WHO_WE_ARE + '\n\n' + CAMPAIGN_TEXT + '\n\n' + STANDING_RULES + '\n\n' +
    'YOU ARE THE JUDGE of a lead-finding agent (round ' + roundNo + '). Below are the collectors\' results (claims to check, not facts). Do the following without opening new sources unless you must settle a doubt: (1) merge duplicates and aliases (same business under different names or sources; keep one record with all source ids); (2) drop what does not qualify: chains, agencies / vendors / competitors, outside the geography, stale evidence, no evidence URL, already in our leads, things that look fake or unverifiable; list each drop with the reason; (3) rank the rest by strength of the observed need signal, reachability and ability to pay hints (observed facts beat hypotheses); also CROSS-MATCH across sources: a business found by 2+ different sources gets multi_source=true and ranks higher (the collectors ran separately and never saw each other, so only you can do this); (4) give every kept candidate a tier: verified (collector opened the signal AND identity was seen in a second place), signal_only (real signal in the data, identity/date not fully checked), fit_only (fits the profile but nothing shows the need), unverified (could not be checked); a scrape_date_only date is not a signal date; (5) usable_count counts ONLY verified + signal_only (never fit_only or unverified; keep those in final_candidates at the bottom with their tier, but do not count them), fill tier_counts, and be honest even when this makes the number small; set enough=true only if usable_count >= ' + Math.ceil(TARGET * 0.6) + '; (6) if not enough, write replan_advice: what to change (other sources, other signals, wider geography), based on which sources failed and why.\n\nNEED ANALYSIS: ' + JSON.stringify(plan.need_analysis) + '\n\nCOLLECTOR RESULTS (JSON):\n' + JSON.stringify(allResults)
  return agent(prompt, { label: 'judge:round' + roundNo, phase: 'Judge', schema: JUDGED })
}

phase('Plan')
const plan1 = await planRound('', 1)
if (!plan1) { return { error: 'planner failed', campaign: C.name } }
log('plan 1 chose: ' + plan1.chosen.map(s => s.id + '(' + s.tool + ')').join(', '))

phase('Collect')
const res1 = (await collectAll(plan1, 'Plan')).filter(Boolean)
log('collected: ' + res1.map(r => r.source_id + '=' + r.candidates.length).join(', '))

phase('Judge')
let judged = await judge(res1, plan1, 1)
let plan2 = null
let res2 = []
if (judged && !judged.enough) {
  log('round 1 yield low (' + judged.usable_count + ' usable of target ' + TARGET + '); re-planning')
  phase('Replan')
  const feedback = 'sources tried: ' + plan1.chosen.map(s => s.id).join(', ') + '. Per-source yield: ' + JSON.stringify(judged.per_source) + '. Judge advice: ' + judged.replan_advice + '. Did not work: ' + res1.map(r => r.source_id + ': ' + r.run_report.did_not_work).join(' | ') + '. Already collected (do not return again): ' + judged.final_candidates.map(c => c.business).join('; ')
  plan2 = await planRound(feedback, 2)
  if (plan2) {
    res2 = (await collectAll(plan2, 'Replan')).filter(Boolean)
    log('round 2 collected: ' + res2.map(r => r.source_id + '=' + r.candidates.length).join(', '))
    judged = await judge(res1.concat(res2), plan2, 2)
  }
}

const allRuns = res1.concat(res2)
const spend = allRuns.reduce((s, r) => s + ((r.run_report && r.run_report.est_cost_usd) || 0), 0)
return {
  campaign: C.name,
  need: C.need,
  plan_round1: plan1,
  plan_round2: plan2,
  sources_used: allRuns.map(r => r.source_id),
  run_reports: allRuns.map(r => ({ source_id: r.source_id, found: r.candidates.length, report: r.run_report })),
  judged: judged,
  est_apify_spend_usd: Math.round(spend * 1000) / 1000,
  note: 'Candidates are CLAIMS with evidence. Run lead-researcher on them before anything is added to a campaign.',
}
