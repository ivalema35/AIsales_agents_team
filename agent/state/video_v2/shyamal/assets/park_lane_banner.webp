/* Coming Soon Page CSS END */

.sgfootertop-sec {
	position: relative;
}
.sgfootertop-sec:before {
	content: '';
	background: linear-gradient(to top, #173e62de 60%, #173e62de 40%);
	display: block;
	width: 100%;
	height: 100%;
	position: absolute;
	left: 0;
	top: 0;
}
.sgfootertop-sec .menu {
	display: flex;
	flex-wrap: wrap;
	margin: 0 -15px !important;
	padding: 0;
}
.sgfootertop-sec .menu li {
	flex: 0 0 100%;
	max-width: 100%;
	margin-bottom: 15px;
	padding: 0 15px;
}
.sgfootertop-sec .menu li a {
	color: #ffffff;
	font-size: 16px;
	line-height: 26px;
	font-family: var(--e-global-typography-primary-font-family);
	font-weight: 400;
	letter-spacing: 0.5px;
	display: block;
	transition: 0.5s;
}
.sgfootertop-sec .menu li a:hover,
.sgfootertop-sec .menu .current-menu-item a {
	color: #BDA588;
	transition: 0.5s;
}

#page-title-bar .breadcrumb {
	display: none;
}
#page-title-bar {
	background-position: center center;
	background-size: cover;
}
.single-osf_portfolio .single-portfolio-summary-meta-title {
	margin: 0 0 35px;
}
.single-osf_portfolio .single-portfolio-summary-meta {
	margin: 0 0 60px;
}
.single-osf_portfolio .single-portfolio-summary-meta .col-xl-9 .row {
	margin-right: 40px;
}
.single-osf_portfolio .single-portfolio-summary-meta .col-xl-9 .row .col-12:first-child {
    display: none;
}
.single-osf_portfolio .single-portfolio-summary-meta .col-xl-9 .row .col-12:last-child {
	flex: 0 0 100%;
	max-width: 100%;
}
.single-osf_portfolio .single-portfolio-summary-meta .col-xl-3 {
	box-shadow: 0 0 12px 0px rgb(0 0 0 / 12%);
	padding: 25px;
} 
.single-osf_portfolio .single-portfolio-summary-meta-list {
	margin-left: 0;
}
.single-osf_portfolio .single-portfolio-summary-meta-list:before {
	content: none;
}
.single-osf_portfolio .single-portfolio-summary-meta-list li {
	display: block;
	padding: 0;
	align-items: start;
	justify-content: start;
	/* 	text-align: right; */
}
.single-osf_portfolio .single-portfolio-summary-meta-list li + li {
	padding-top: 10px;
}
.single-osf_portfolio .single-portfolio-summary-meta-list li span {
	display: block;
	font-size: 15px;
	line-height: 22px;
}
.single-osf_portfolio .single-portfolio-summary-meta-list li .meta-title {
	display: inline-block;
	position: relative;
	padding-right: 15px;
}
.single-osf_portfolio .single-portfolio-summary-meta-list li .meta-title:after {
	content: ':';
	position: absolute;
	right: 5px;
}
.amenities-boxes .elementor-widget-wrap {
	display: flex;
	flex-wrap: wrap;
	justify-content: center;
}
.amenities-boxes .elementor-widget-icon-box {
	flex: 0 0 25%;
	max-width: 25%;
	margin-top: 60px;
	padding: 0 15px;
}
.single-osf_portfolio .wpcf7 input[type=color], 
.single-osf_portfolio .wpcf7 input[type=date], 
.single-osf_portfolio .wpcf7 input[type=datetime-local], .single-osf_portfolio .wpcf7 input[type=datetime], 
.single-osf_portfolio .wpcf7 input[type=email], 
.single-osf_portfolio .wpcf7 input[type=month], 
.single-osf_portfolio .wpcf7 input[type=number], 
.single-osf_portfolio .wpcf7 input[type=password], 
.single-osf_portfolio .wpcf7 input[type=range], 
.single-osf_portfolio .wpcf7 input[type=search], 
.single-osf_portfolio .wpcf7 input[type=tel], 
.single-osf_portfolio .wpcf7 input[type=text], 
.single-osf_portfolio .wpcf7 input[type=time], 
.single-osf_portfolio .wpcf7 input[type=url], 
.single-osf_portfolio .wpcf7 input[type=week] {
	margin-bottom: 20px !important;
}
.single-osf_portfolio form p,
.single-osf_portfolio form .btn {
	margin-bottom: 0 !important;
}
.single-osf_portfolio form .btn {
	margin-top: 35px !important;
}
.single-osf_portfolio .elementor-text-editor p a {
	color: #ac8d68;
}

.project-plan-tabs .plan-tab-buttons {
	display: flex;
	margin-bottom: 25px;
	flex-wrap: wrap;
	justify-content: center;
}
.project-plan-tabs .plan-tab-btn {
	color: #000000;
	background: transparent;
	font-family: "Roboto";
	font-size: 16px;
	line-height: 26px;
	font-weight: 600;
	letter-spacing: 1px;
	border-style: solid;
	border-width: 0px 0px 2px 0px;
	border-color: #ffffff;
	padding: 12px 0px 5px 0px;
	margin: 0px 20px 0px 20px;
}
.project-plan-tabs .plan-tab-btn.active {
	color: #bda588 !important;
	background-color: rgba(0, 0, 0, 0) !important;
	border-color: #bda588 !important;
}
.project-plan-tabs .plan-tab-content {
	display: none;
}
.project-plan-tabs .plan-tab-content.active {
	display: block;
}
.project-plan-tabs .plan-tab-content .plan-imgsbox {
	display: flex;
	flex-wrap: wrap;
	margin: 0 -15px;
	justify-content: center;
}
.project-plan-tabs .plan-tab-content .plan-imgsbox .planimg {
	flex: 0 0 50%;
	max-width: 50%;
	padding: 0 15px;
}
.project-plan-tabs .plan-tab-content img {
	max-width: 100%;
	height: auto;
	display: block;
}


/* Testimonials */
.testimonial-sec .elementor-testimonial-item-wrapper .row {
	margin: 0;
}
.testimonial-sec .elementor-testimonial-item-wrapper .elementor-testimonial-item {
	flex: 0 0 31.33%;
	max-width: 31.33%;
	margin: 0 1% 30px;
}


/* Team Section */
.ourteam-sec .teambox {
	background-color: #ffffff;
	box-shadow: 0 0 9px 0 rgb(0 0 0 / 12%);
	border-radius: 15px;
	padding: 25px;
}
.ourteam-sec .teambox + .teambox {
	margin-top: 40px;
}
.ourteam-sec .teambox .elementor-image-box-wrapper {
	align-items: center !important;
}
.ourteam-sec .teambox:nth-child(even) .elementor-image-box-wrapper {
	flex-direction: row-reverse;
}
.ourteam-sec .teambox:nth-child(even) .elementor-image-box-wrapper .elementor-image-box-img {
	margin-right: 0;
	margin-left: 25px;
}


/* Project Page */
.portfolio-grid {
	display: flex;
	flex-wrap: wrap;
	counter-reset: portfolio-counter;
}
.portfolio-grid .portfolio-item {
	display: block;
	flex: 0 0 31.33%;
	max-width: 31.33%;
	margin: 0 1% 30px;
	position: relative;
	border-radius: 10px;
	counter-increment: portfolio-counter;
}
.portfolio-grid .portfolio-item:before {
	content: '';
	background-color: #173E62;
	border-radius: 10px;
	display: block;
	height: 100%;
	width: 100%;
	position: absolute;
	left: 0;
	top: 0;
	opacity: 0.65;
	z-index: 1;
}
.portfolio-grid .portfolio-item::after {
	content: counter(portfolio-counter, decimal-leading-zero);
	position: absolute;
	bottom: 20px;
	right: 25px;
	color: #ffffff;
	font-size: 50px;
	line-height: 50px;
	z-index: 2;
	font-family: "DM Serif Display", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
	font-weight: 400;
	opacity: 0.3;
	transition: 0.5s;
}
.portfolio-grid .portfolio-item .portfolio-image,
.portfolio-grid .portfolio-item img {
	border-radius: 10px;
	display: block;
	width: 100%;
	overflow: hidden;
}
.portfolio-grid .portfolio-item img {
	transform: scale(1);
	transition: 0.5s;
}
.portfolio-grid .portfolio-item .portfolio-title {
	color: #ffffff;
	position: absolute;
	bottom: 25px;
	left: 25px;
	font-size: 24px;
	line-height: 34px;
	margin: 0;
	padding: 0;
	z-index: 2;
}
.portfolio-grid .portfolio-item:hover img {
	transform: scale(1.1);
	transition: 0.5s;
}
.portfolio-grid .portfolio-item:hover:after {
	opacity: 1;
	transition: 0.5s;
}


/* Contact Page */
.wpcf7 div.wpcf7-response-output {
	position: initial;
}
.wpcf7-response-output {
	background: transparent !important;
	color: #000000 !important;
	font-size: 18px;
	line-height: 28px;
	font-weight: 700;
	text-align: center;
	padding: 15px !important;
}
textarea {
	margin-bottom: 30px;
}
.wpcf7-not-valid-tip {
	margin: -18px 0 0 !important;
}



@media (max-width: 1199px) {	
	
	#page-title-bar .wrap {
		min-height: 450px !important;
	}

	.single-osf_portfolio .single-portfolio-summary-meta .col-xl-9 .row {
		margin-right: 0;
		margin-bottom: 25px;
	}
	.single-osf_portfolio .single-portfolio-summary-meta-list li span {
		display: initial;
	}

	.testimonial-sec .elementor-testimonial-item-wrapper .elementor-testimonial-item {
		flex: 0 0 48%;
		max-width: 48%;
	}
	
	.ourteam-sec .teambox .elementor-image-box-wrapper {
		display: flex;
		flex-wrap: wrap;
	}
	.ourteam-sec .teambox .elementor-image-box-wrapper .elementor-image-framed,
	.ourteam-sec .teambox .elementor-image-box-wrapper .elementor-image-box-content {
		flex: 0 0 100%;
		max-width: 100%;
		text-align: center;
	}
	.ourteam-sec .teambox .elementor-image-box-wrapper .elementor-image-box-img {
		display: block;
		margin: 0 auto 20px !important;
		text-align: center;
		width: 250px;
		max-width: 100%;
	}
	
	.portfolio-grid .portfolio-item {
		flex: 0 0 48%;
		max-width: 48%;
	}
	
	.project-plan-tabs .plan-tab-content {
		padding: 0 20px;
	}

}

@media (max-width: 991px) {
	#page-title-bar .wrap {
		min-height: 270px !important;
	}

	.amenities-boxes .elementor-widget-icon-box {
		flex: 0 0 33.33%;
		max-width: 33.33%;
		margin-top: 50px;
	}

}

@media (max-width: 767px) {
	
	.sgfootertop-sec .menu li {
		flex: 0 0 33.33%;
		max-width: 33.33%;
	}
	
	#page-title-bar .wrap {
		min-height: 250px !important;
	}

	.amenities-boxes .elementor-widget-icon-box {
		flex: 0 0 50%;
		max-width: 50%;
	}

