ENV=development
DB_PATH=sales_system.db
FRONTEND_ORIGIN=http://localhost:5173

# LLM provider — swappable, one line to change (tracker.md §A.1). One of: gemini, openai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-latest

GEMINI_API_KEY=
OPENAI_API_KEY=

RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
PUBLIC_BASE_URL=http://localhost:5000
COMPANY_PHYSICAL_ADDRESS=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_WABA_ID=
WHATSAPP_API_BASE_URL=https://waba.fortius.in.net
WHATSAPP_API_VERSION=v21.0
SLACK_WEBHOOK_URL=

# Data acquisition (lead discovery / enrichment) — free-tier providers in use
SERPER_API_KEY=
HUNTER_API_KEY=
# Not in use yet (require billing even on "free" tier) — left here for later
SERPAPI_KEY=
PLACES_API_KEY=
